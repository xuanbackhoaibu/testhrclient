NODE_ENV=production
NGINX_ENTRYPOINT_QUIET_LOGS=1

# ─── Runtime env injection ────────────────────────────────────────────────────
# These vars are injected into the Vite JS bundle at container startup by
# deploy/docker/entrypoint.sh. Edit this file on the server to change URLs
# without rebuilding the image.
#
# Auth API (chat-auth-service) — MUST point to the chat-auth-service host.
VITE_AUTH_API_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1

# Auth service base URL (used for login/logout redirects and token endpoints).
VITE_AUTH_SERVICE_BASE_URL=https://hacom-chat.fitora.id.vn/api/v1/auth
VITE_AUTH_SERVICE_LOGIN_URL=https://hacom-chat.fitora.id.vn/api/v1/auth/login
VITE_AUTH_SERVICE_LOGOUT_URL=https://hacom-chat.fitora.id.vn/api/v1/auth/logout

# Docker network
CHAT_NETWORK=chat-platform
