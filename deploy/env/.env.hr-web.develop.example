NODE_ENV=production
NGINX_ENTRYPOINT_QUIET_LOGS=1

# Browser API base URL is baked into the Vite bundle from GitHub variable
# VITE_HR_API_BASE_URL at image build time. Default it to /api when HR Web and
# HR API share the same reverse proxy.
#
# Deploy smoke runs on the server host shell, so this must be reachable from the
# host. Do not use Docker-only service DNS here unless smoke is moved into the
# Docker network.
HR_API_HEALTH_URL=CHANGE_ME_SET_ACTUAL_HR_API_HEALTH_URL
