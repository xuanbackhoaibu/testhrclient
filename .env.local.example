# FE local + backend LOCAL hoàn toàn — KHÔNG đụng tới production.
#
# Dùng khi cần test các thao tác GHI (tạo/sửa/xoá/duyệt) mà không muốn
# ảnh hưởng dữ liệu thật. Cách dùng:
#     cp .env.local.example .env       # rồi npm run dev
# Quay lại production: khôi phục .env bản production (xem git hoặc chú thích ở đó).
#
# Yêu cầu backend local đang chạy trên máy này:
#   hr-api-service    :3002  (Docker container hr-api-service-docker)
#   chat-auth-service :3101  (Docker container chat-auth-service-docker)
#   Postgres          :5432  (database hrm + chat_auth_db)
#
# Tài khoản test: đăng ký qua POST /api/v1/auth/register rồi kích hoạt trong DB
# (account_status/account_state = ACTIVE), gán role trong auth.user_roles và
# liên kết hồ sơ nhân sự qua bảng "user".externalAuthUserId của database hrm.
# Dữ liệu nhân sự mẫu: chạy `npm run prisma:seed` trong hr-api-service.
#
# HR API gọi THẲNG :3002, không qua nginx :80. Lý do: cả hr-api-service và
# chat-auth-service đều có route /api/v1/auth/me nhưng trả dữ liệu khác nhau
# (HR trả hồ sơ nhân sự + quyền HRM; chat-auth trả identity tài khoản).
# nginx route theo path prefix nên không phân biệt được hai cái, khiến
# hr-web-client nhận nhầm response của chat-auth và báo lỗi không có quyền.
#
# Ở đây dùng URL tuyệt đối (khác bản production dùng /api/v1 tương đối) vì
# hr-api-service local đã whitelist sẵn http://localhost:5173 trong CORS_ORIGIN,
# nên gọi cross-origin trực tiếp được. Backend production thì không whitelist
# localhost nên bắt buộc phải đi qua Vite proxy bằng đường dẫn tương đối.

VITE_HR_API_BASE_URL=http://localhost:3002/api/v1
VITE_API_BASE_URL=http://localhost:3002/api/v1

VITE_AUTH_API_BASE_URL=http://localhost/api/v1

VITE_APP_SYSTEM_CODE=HRM

VITE_USE_MOCKS=false

VITE_AUTH_MODE=auth-service
VITE_AUTH_SERVICE_PROVIDER=chat-auth
VITE_AUTH_SERVICE_BASE_URL=http://localhost/api/v1/auth
VITE_AUTH_SERVICE_LOGIN_URL=http://localhost/api/v1/auth/login
VITE_AUTH_SERVICE_LOGOUT_URL=http://localhost/api/v1/auth/logout
VITE_AUTH_SERVICE_CLIENT_ID=hr-web-client
VITE_AUTH_SERVICE_REDIRECT_URI=http://localhost:5173/auth/callback

VITE_CHAT_AUTH_BASE_URL=http://localhost/api/v1/auth
VITE_CHAT_AUTH_LOGIN_URL=http://localhost/api/v1/auth/login
VITE_CHAT_AUTH_LOGOUT_URL=http://localhost/api/v1/auth/logout
VITE_CHAT_AUTH_CLIENT_ID=hr-web-client
VITE_CHAT_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
