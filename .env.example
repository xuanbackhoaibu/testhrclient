# Local UI development can point directly at a remote/develop HR API.
# HR API canonical base. Legacy /api remains a temporary backend alias.
VITE_API_BASE_URL=https://<server-host-or-domain>/api/v1
VITE_USE_MOCKS=true

VITE_AUTH_MODE=auth-service
VITE_AUTH_SERVICE_PROVIDER=chat-auth
VITE_AUTH_SERVICE_BASE_URL=https://<server-host-or-domain>/api/v1/auth
# POST endpoint used by the HR web login form. Do not use this as a browser redirect URL.
VITE_AUTH_SERVICE_LOGIN_URL=https://<server-host-or-domain>/api/v1/auth/login
VITE_AUTH_SERVICE_LOGOUT_URL=https://<server-host-or-domain>/api/v1/auth/logout
VITE_AUTH_SERVICE_CLIENT_ID=hr-web-client
VITE_AUTH_SERVICE_REDIRECT_URI=http://localhost:5173/auth/callback

# Backward-compatible aliases. Prefer VITE_AUTH_SERVICE_* for new deployments.
VITE_CHAT_AUTH_BASE_URL=https://<server-host-or-domain>/api/v1/auth
VITE_CHAT_AUTH_LOGIN_URL=https://<server-host-or-domain>/api/v1/auth/login
VITE_CHAT_AUTH_LOGOUT_URL=https://<server-host-or-domain>/api/v1/auth/logout
VITE_CHAT_AUTH_CLIENT_ID=hr-web-client
VITE_CHAT_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
